{
  "name": "despense-agent",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/despense-agent",
  "projectType": "application",
  "tags": [],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/despense-agent",
        "command": "pip install -r requirements.txt"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/despense-agent",
        "command": "python whatsapp_server.py"
      }
    },
    "serve-agent": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/despense-agent",
        "command": "python despensa_agent.py",
        "tty": true
      }
    }
  }
}
